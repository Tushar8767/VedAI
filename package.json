{
  "name": "vedai",
  "version": "1.0.0",
  "description": "VedAI - Emotion-aware mental well-being support system with Bhagavad Gita wisdom",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:ml": "uvicorn ml_model.app:app --reload --port 8001",
    "start:frontend": "cd frontend && live-server --port=3000 --open=/index.html",
    "install:all": "npm install && cd frontend && npm install",
    "dev": "concurrently \"npm run start\" \"npm run start:ml\" \"npm run start:frontend\"",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "vedai",
    "mental-health",
    "emotion-detection",
    "bhagavad-gita",
    "ai",
    "wellbeing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "live-server": "^1.2.2"
  }
} 
