# VedAI Production Environment Configuration

# Server Ports & Node Environment
NODE_ENV=production
PORT=5000

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=vedai
PGUSER=postgres
PGPASSWORD=1234
PG_MAX_POOL=25

# AI / ML Microservice
MODEL_API_URL=http://localhost:8001/predict
MODEL_TIMEOUT_MS=10000
LOAD_ONLINE_MODEL=0

# YouTube Data API (Optional - Curated fallback active)
YOUTUBE_API_KEY=

# Authentication & Security
JWT_SECRET=vedai-production-super-secret-key-replace-me-with-long-random-string
JWT_TTL_SECONDS=604800
ENCRYPTION_KEY=replace-with-32-byte-hex-or-strong-passphrase

