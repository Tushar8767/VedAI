# VedAI Environment Configuration
# Copy this file to .env and fill in your actual values

# YouTube Data API Key (required for video recommendations)
# Get it from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# ML Model API URL (optional, default is provided)
MODEL_API_URL=http://localhost:8001/predict

# Backend Server Port (optional, default is 5000)
PORT=5000

