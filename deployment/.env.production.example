# ==============================================================================
# VedAI 2.0 — Production Environment Specification Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this template to .env on your deployment host.
# Inject credentials securely via CI/CD secrets or environment managers.
# NEVER COMMIT REAL PRODUCTION CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ==============================================================================
# 1. REQUIRED PRODUCTION VARIABLES (Must be defined for full platform features)
# ==============================================================================

# Core Runtime Environment
NODE_ENV=production
PORT=5000

# Client & CORS Whitelisting
FRONTEND_URL=https://vedai.example.com
CLIENT_URL=https://vedai.example.com

# Database Connection (MongoDB Atlas TLS Cluster)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority

# JWT Token Security (Use a cryptographically secure 64+ char random string)
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_64_CHAR_SECRET
JWT_EXPIRES_IN=7d

# Python ML Microservice URL (FastAPI / DistilBERT Multilingual)
# In Docker Compose, this resolves to the internal container DNS 'http://ml-service:8001/predict'
MODEL_API_URL=http://ml-service:8001/predict
MODEL_TIMEOUT_MS=10000

# Transactional Password Reset Email Delivery (SMTP)
# Required for live password-reset email delivery; if omitted, tokens expire safely without dispatch
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SMTP_CREDENTIAL_OR_API_KEY
SMTP_FROM=VedAI Support <noreply@vedai.example.com>


# ==============================================================================
# 2. OPTIONAL ENHANCEMENT VARIABLES (Platform functions gracefully with defaults)
# ==============================================================================

# Grounded Generative LLM Provider (Google Gemini / OpenAI compatible)
# If omitted or offline, the platform seamlessly engages its verified deterministic grounded engine
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=REPLACE_WITH_VALID_GEMINI_API_KEY
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT_MS=8000

# External Media / Curated Resources API (YouTube Data API v3)
YOU_TUBE_API=REPLACE_WITH_OPTIONAL_YOUTUBE_API_KEY


# ==============================================================================
# 3. DEVELOPMENT ONLY VARIABLES (DO NOT USE IN PRODUCTION DEPLOYMENTS)
# ==============================================================================
# The following settings are strictly forbidden in production:
# - Setting NODE_ENV=development (leaks stack traces and debug details)
# - Using hardcoded JWT secret fallbacks
# - Permitting insecure wildcard CORS origins (*)
